{
  "name": "@nexora/auth-service",
  "version": "1.0.0",
  "description": "Nexora Auth service",
  "main": "src/auth-server.ts",
  "scripts": {
    "dev": "tsx watch src/auth-server.ts",
    "start": "node dist/auth-server.js",
    "build": "tsc",
    "prisma:emit": "prisma contract emit",
    "prisma:migration:plan": "prisma migration plan --name 'give name'",
    "prisma:db:migrate": "prisma db migrate --advance-ref db",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\" prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "outbox:dev": "tsx watch src/workers/auth-outbox-worker.ts"
  },
  "keywords": [
    "nexora",
    "auth",
    "service"
  ],
  "author": "Bharathi Kannaa",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@nexora/kafka": "workspace:*",
    "@nexora/outbox": "workspace:*",
    "@nexora/schemas": "workspace:*",
    "@nexora/shared": "workspace:*",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "bcryptjs": "^3.0.3",
    "cldr-core": "48.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "countries-and-timezones": "3.11.0",
    "countries-list": "3.4.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "temporal-polyfill": "^1.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nexora/eslint-config": "workspace:*",
    "@prisma/cli-engine": "0.9.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "eslint": "^10",
    "prisma": "8.0.0-rc.27",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
