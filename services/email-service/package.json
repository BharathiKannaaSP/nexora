{
  "name": "@nexora/email-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_SYSTEM_CA=1 tsx watch src/email-server.ts",
    "build": "tsc",
    "start": "node dist/email-server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nexora/kafka": "workspace:*",
    "@nexora/shared": "workspace:*",
    "dotenv": "^18.0.7",
    "eslint": "^10",
    "nodemailer": "^7.0.0",
    "resend": "^6.34.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^6.4.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  }
}
