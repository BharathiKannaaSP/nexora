{
  "name": "@nexora/api-gateway",
  "version": "1.0.0",
  "description": "Nexora API Gateway",
  "main": "src/gateway-server.ts",
  "scripts": {
    "dev": "tsx watch src/gateway-server.ts",
    "start": "node dist/gateway-server.js",
    "build": "tsc",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "gateway"
  ],
  "author": "Bharathi Kannaa",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@nexora/eslint-config": "workspace:*",
    "eslint": "^10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
