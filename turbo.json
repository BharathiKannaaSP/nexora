{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "PORT",
        "CLERK_SECRET_KEY",
        "CLIENT_URL",
        "ADMIN_URL",
        "AUTH_SERVICE_URL",
        "ONBOARDING_SERVICE_URL",
        "INTERNAL_SERVICE_SECRET",
        "RATE_LIMIT_WINDOW_MS",
        "RATE_LIMIT_MAX",
        "CLERK_WEBHOOK_SIGNING_SECRET",
        "DATABASE_URL",
        "KAFKA_GROUP_ID",
        "CONVEX_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
