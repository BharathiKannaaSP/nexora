{
  "extends": "@nexora/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@nexora/ui/*": ["../../packages/ui/src/*"],
      "@nexora/schemas/*": ["../../packages/schemas/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
