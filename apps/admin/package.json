{
  "name": "@nexora/admin",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "pnpm i18n:check && next build",
    "start": "next start",
    "lint": "eslint && pnpm i18n:check",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "i18n:check": "i18n-check --locales locales --source en"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@nexora/schemas": "workspace:*",
    "@nexora/shared": "workspace:*",
    "@nexora/ui": "workspace:*",
    "@tanstack/react-table": "^9.3.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-phone-number-input": "^3.4.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lingual/i18n-check": "^0.9.5",
    "@nexora/eslint-config": "workspace:^",
    "@nexora/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "typescript": "^5"
  }
}
